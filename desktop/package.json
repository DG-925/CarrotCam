{
  "name": "carrotcam",
  "productName": "CarrotCam",
  "version": "1.6.1",
  "description": "CarrotCam - studio webcam with a phone camera, effects and a virtual camera",
  "main": "./out/main/index.js",
  "author": "DG-925",
  "license": "MIT",
  "homepage": "https://github.com/DG-925/CarrotCam",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/fetch-assets.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win --x64",
    "release": "electron-vite build && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "bonjour-service": "1.4.4",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "koffi": "3.3.2",
    "lucide-react": "1.51.0",
    "motion": "14.0.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vosk-browser": "0.0.8",
    "ws": "8.22.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "allowScripts": {
    "koffi@3.3.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  }
}
